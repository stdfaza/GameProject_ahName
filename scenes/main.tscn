theme_override_font_sizes/font_size = 42
text = "YOU DIED"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="MenuLayer/GameOverPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.7, 0.5, 1)
theme_override_font_sizes/font_size = 16
text = "The fire consumed your body."
horizontal_alignment = 1

[node name="RetryBtn" type="Button" parent="MenuLayer/GameOverPanel/VBox"]
custom_minimum_size = Vector2(160, 44)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 20
text = "TRY AGAIN"

[node name="VictoryPanel" type="PanelContainer" parent="MenuLayer"]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -130.0
offset_right = 240.0
offset_bottom = 130.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("Style_Panel")

[node name="VBox" type="VBoxContainer" parent="MenuLayer/VictoryPanel"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Title" type="Label" parent="MenuLayer/VictoryPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 1, 0.65, 1)
theme_override_font_sizes/font_size = 38
text = "MISSION COMPLETE"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="MenuLayer/VictoryPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.7, 0.5, 1)
theme_override_font_sizes/font_size = 16
text = "All fire entities extinguished. Hell is silenced."
horizontal_alignment = 1

[node name="PlayAgainBtn" type="Button" parent="MenuLayer/VictoryPanel/VBox"]
custom_minimum_size = Vector2(160, 44)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 20
text = "PLAY AGAIN"

[connection signal="pressed" from="MenuLayer/StartPanel/VBox/StartBtn" to="." method="_on_start_pressed"]
[connection signal="pressed" from="MenuLayer/GameOverPanel/VBox/RetryBtn" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="MenuLayer/VictoryPanel/VBox/PlayAgainBtn" to="." method="_on_retry_pressed"]
